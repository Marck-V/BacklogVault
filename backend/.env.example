# For running the API directly with `npm run dev` (Docker uses the .env file in the repository root instead).
# Copy to .env, which is git-ignored, and fill in your own credentials from the Twitch developer console.
IGDB_CLIENT_ID=your_twitch_client_id
IGDB_CLIENT_SECRET=your_twitch_client_secret

# Optional. A Steam Web API key (https://steamcommunity.com/dev/apikey) turns on "Import from Steam". Leave empty to switch it off.
STEAM_API_KEY=
PORT=4000
