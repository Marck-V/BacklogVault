{
  "name": "backlog-tracker-backend",
  "version": "1.0.0",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage --coverage.include=src/** --coverage.reporter=text",
    "claim-legacy": "node scripts/claim-legacy.js",
    "backup": "node scripts/backup.js"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^5.0.3",
    "supertest": "^7.3.1",
    "vitest": "^5.0.3"
  }
}
