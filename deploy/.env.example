# Copy to .env on the server (next to docker-compose.prod.yml) and fill in. Never commit the real file.

# The public name, without https://. Caddy gets the HTTPS certificate for it.
SITE_ADDRESS=backlogvault.duckdns.org

# IGDB (game data): https://api-docs.igdb.com/#account-creation
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=

# Optional: Steam Web API key (https://steamcommunity.com/dev/apikey). Register SITE_ADDRESS as the key's domain.
STEAM_API_KEY=

# Accounts stay off for the guests-only launch.
ENABLE_ACCOUNTS=false

# Optional but strongly recommended: where backup.sh uploads the nightly copy (a Google Cloud Storage bucket).
BACKUP_BUCKET=
