# Copy to .env (git-ignored) before running `docker compose up`
IGDB_CLIENT_ID=your_twitch_client_id
IGDB_CLIENT_SECRET=your_twitch_client_secret

# Optional. A Steam Web API key (https://steamcommunity.com/dev/apikey) turns on "Import from Steam". Leave empty to switch it off.
STEAM_API_KEY=

# The address visitors use to open the site. "Connect Steam" sends people back here after they sign in on Steam,
# so set it to the real address (https://...) once the site is deployed.
PUBLIC_URL=http://localhost:8080

# Shown on the privacy page. Steam's API terms require the policy to name the country where Steam data is stored
# (the country your server is in) and a way to reach you. Set both before the site is public.
DATA_COUNTRY=United States
CONTACT_EMAIL=

# Sign up and sign in. Off by default: visitors get a library on their device without an account. Set to true to offer accounts.
ENABLE_ACCOUNTS=false

# Proxies in front of the API (used for per-IP rate limits). Caddy is the only one, so 1.
TRUST_PROXY_HOPS=1

# Where the site is served. ":80" = plain HTTP for local runs. On the server, the public name (for example
# backlogvault.duckdns.org): Caddy then gets and renews the HTTPS certificate by itself.
SITE_ADDRESS=:80
