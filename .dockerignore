# Keeps the build context small and, above all, keeps secrets and local data out of the image.
**/node_modules
**/dist
**/coverage
**/.env
**/.env.*
**/*.db
**/*.db-shm
**/*.db-wal
**/*.bak
.git
.github
ts-report
backend/test
backend/vitest.config.ts
frontend/src/**/*.test.tsx
frontend/src/**/*.test.ts
